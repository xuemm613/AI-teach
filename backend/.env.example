# ================= 环境配置示例（复制为 .env 后修改） =================

# MySQL（aiomysql 异步驱动；charset=utf8mb4 保证中文/emoji 正确存储）
# 账号密码按本机实际修改，端口默认 3306
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/ai_edu?charset=utf8mb4

# Milvus Lite 本地存储路径（相对 backend 目录）
MILVUS_URI=./milvus_data.db
MILVUS_COLLECTION=knowledge_chunks

# 本地嵌入模型名称（HuggingFace sentence-transformers）
# 首次运行需联网下载模型（约 2.2GB，bge-m3），之后完全离线。
# 若下载不便，可换小模型：BAAI/bge-small-zh-v1.5（约 100MB，维度 512）
# 若使用本机已部署的本地模型（sentence-transformers 格式），直接填绝对路径即可，无需改代码：
# EMBEDDING_MODEL_NAME=E:/Models/ritrievev1
# EMBEDDING_DIM=1024
EMBEDDING_MODEL_NAME=r"E:\Models\ritrievev1"
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

# 大模型 API（兼容 OpenAI 接口，可切换 DeepSeek / 通义千问 / 智谱 GLM 等）
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-kdjfkxqsvw50wyczjdhb
LLM_MODEL_NAME=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120

# JWT
SECRET_KEY=password
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# RAG
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35

# 文本切分（字符数）
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 文件存储
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# 调试
DEBUG=false